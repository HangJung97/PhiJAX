{% extends "_base/function.html.jinja" %}

{% block heading scoped %}
  {{ super() }}
  {% if function.relative_filepath and function.lineno and function.endlineno %}
    <a class="doc-source-link"
       href="{{ config.extra.source_repository }}/blob/{{ config.extra.source_ref }}/{{ function.relative_filepath }}#L{{ function.lineno }}-L{{ function.endlineno }}"
       title="View source code">[source]</a>
  {% endif %}
{% endblock heading %}
